# =============================================================
#  Page de remerciement TenderPilot - configuration
#  Renseignez vos valeurs ci-dessous puis deploiement.
#  Ce fichier ne doit JAMAIS etre visible sur le web :
#  il est protege par .htaccess et ignore par git.
# =============================================================

# --- Secrets Chariow (a creer sur app.chariow.com) ---
# Cle API : Settings -> API Keys -> Create API Key
CHARIOW_API_KEY=sk_live_VOTRE_CLE_ICI
# Secret Webhook : Automations -> Pulses -> votre Pulse -> Overview
CHARIOW_WEBHOOK_SECRET=whsec_VOTRE_SECRET_ICI

# --- Produit et redirection ---
# Identifiant du produit (celui du bouton d'achat actuel)
PRODUIT_ID=prd_n2wrx3qc
# Adresse publique de la page de remerciement (HTTPS)
URL_REDIRECTION=https://TON-DOMAINE.com/thank-you

# --- Contact et produit ---
NOM_PRODUIT=TenderPilot
NUMERO_WHATSAPP=+229 01 67 65 97 17
LIEN_WHATSAPP=https://wa.me/2290167659717
# Lien d'invitation au groupe WhatsApp prive des acheteurs (video: laisser vide si pas encore cree)
LIEN_GROUPE_WHATSAPP=
EMAIL_CONTACT=contact@tenderpilot.store
# Lien du fichier livre a copier (vide si le lien est sur le portail Chariow)
LIEN_FICHIER=
# Video d'aide pour dezipper : URL YouTube en embed (iframe src)
VIDEO_DEZIPPER_EMBED=
# Videos d'aide pour dezipper (liens cliquables dans le mail recap)
VIDEO_DEZIPPER_PC=https://www.youtube.com/watch?v=Qv4YnL6CmRc
VIDEO_DEZIPPER_MAC=https://www.youtube.com/watch?v=EWB3jcsrpOc
# Acces LECTEUR au classeur maitre (via partage-sheet.gs, Web app) apres achat
SHEET_SHARE_APP_URL=
SHEET_SHARE_TOKEN=

# --- Operateur notifie a chaque vente (succes ou alerte d'acces) ---
# Vide = EMAIL_CONTACT
EMAIL_OPERATEUR=

# --- File d'attente (webhook -> worker) ---
# Le webhook enfile, worker.php (cron) traite : c'est ce decouplage qui
# encaisse les pics de paiement sans bloquer le site. Voit README.
WORKER_MAX_JOBS=5
WORKER_MAX_SECONDES=55
WORKER_MAX_TENTATIVES=3
WORKER_DELAI_RETOUR_SEC=300

# Chariow (liens officiels, par defaut)
LIEN_GUIDE_CHARIOW=https://chariow.dev/en/guides/checkout
LIEN_PORTAL_CHARIOW=https://portal.chariow.com/en