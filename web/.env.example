# ---------------------------------------------------------------------------
# TenderPilot - configuration
#
# Copiez ce fichier en ".env" et remplissez ce dont vous avez besoin.
# Seule la premiere ligne est obligatoire, et sa valeur par defaut convient.
# ---------------------------------------------------------------------------

# Base de donnees : un simple fichier dans le projet. Rien a installer.
DATABASE_URL="file:./dev.db"

# Envoi des emails. Sans cle, les emails s'affichent dans la console au lieu
# d'etre envoyes : parfait pour essayer. Cle gratuite sur resend.com
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="TenderPilot <onboarding@resend.dev>"

# Protege la collecte automatique contre les appels exterieurs.
# Inventez n'importe quelle suite de caracteres.
CRON_SECRET="changez-cette-valeur"
