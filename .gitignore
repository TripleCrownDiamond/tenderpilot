# --------------------------------------------------------------------
# Secrets. Ne doivent jamais partir sur un depot, meme prive.
# --------------------------------------------------------------------
web/.env
web/.env.local
web/.env.*.local
*.key
*.pem

# Le lien /copy est la marchandise : quiconque l'a peut copier le
# produit. Le modele reste versionne (livraison.example.json).
data/livraison.json

# --------------------------------------------------------------------
# Dependances et caches
# --------------------------------------------------------------------
node_modules/
.next/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/

# --------------------------------------------------------------------
# Livrable : entierement regenere par `python build.py`.
# Le versionner ferait un diff illisible a chaque build, pour un
# contenu qu'on peut reconstruire en dix secondes.
#
# dist/ARCHIVES garde une copie datee de chaque version publiee, pour
# retrouver ce qu'un client a recu il y a six mois. Elle reste locale :
# les versions durables se publient en releases GitHub.
# --------------------------------------------------------------------
dist/

# .claude/skills/ est GENERE depuis AGENTS.md mais reste versionne : un
# clone frais doit avoir la skill sans avoir a lancer le build.
# Un test refuse toute divergence entre les deux.

# --------------------------------------------------------------------
# Systeme et editeurs
# --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Artefact d outil local, sans rapport avec le projet.
.freebuff/
